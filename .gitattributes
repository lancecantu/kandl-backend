# Normalize line endings. Without this, `core.autocrlf=true` on Windows checks
# files out as CRLF, and contributors on macOS/Linux see whole-file diffs that
# are nothing but line-ending churn. LF in the repository and in the working
# copy keeps the history readable for everyone.
* text=auto eol=lf

# Generated by npm, not hand-edited. Collapsed by default in GitHub diffs and
# excluded from language stats.
functions/package-lock.json linguist-generated=true
